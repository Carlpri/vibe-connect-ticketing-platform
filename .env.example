# ============================================
# VIBE-CONNECT Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to Git!
# ============================================

# Server
NODE_ENV=development
PORT=3000

# Database (Supabase PostgreSQL)
# -----------------------------------------------
# Find these in your Supabase Dashboard:
#   Project Settings > Database > Connection string
#
# DATABASE_URL        → Used by Prisma for queries (Transaction Pooler, port 6543)
# DIRECT_URL          → Used by Prisma for migrations (Direct Connection, port 5432)
# -----------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# JWT Authentication
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d
