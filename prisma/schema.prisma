// =============================================
// Prisma Schema — VIBE-CONNECT Database
// =============================================
// Carlos's Domain:
// - Backend Foundation, Users, Authentication & Security
// - Email & Phone Contact Verification Lifecycle
//
// Database Configuration:
// - Direct URL: Supabase Session pooler (port 5432) for migrations
// - Transaction URL: Supabase Transaction pooler (port 6543) for pooled queries
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// Carlos's Domain: User Roles & Authentication
// -------------------------------------------------------------

enum UserRole {
  ATTENDEE
  ORGANIZER
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  phone        String?   @unique
  role         UserRole  @default(ATTENDEE)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  // Verification Status Flags
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  // Email Verification Fields (tokens stored as SHA-256 hashes only)
  emailVerificationTokenHash       String?
  emailVerificationExpiresAt       DateTime? @db.Timestamptz
  emailVerificationCooldownUntil   DateTime? @db.Timestamptz

  // Phone OTP Verification Fields (OTPs stored as SHA-256 hashes only)
  phoneVerificationOtpHash         String?
  phoneVerificationExpiresAt       DateTime? @db.Timestamptz
  phoneVerificationAttempts        Int       @default(0)
  phoneVerificationCooldownUntil   DateTime? @db.Timestamptz

  orders Order[]
  @@index([emailVerificationTokenHash])
  @@map("users")
}


// -------------------------------------------------------------
// Phillip's Domain (To be implemented by Phillip):
// - Event
// - TicketType
// -------------------------------------------------------------

// -------------------------------------------------------------
// Freddy's Domain (To be implemented by Freddy):
// - Order
// - OrderItem
// - Ticket (Digital QR ticket & check-in)
// -------------------------------------------------------------
enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  eventId   String      @db.Uuid     // TODO: add @relation to Event once Phillip's model is merged
  status    OrderStatus @default(PENDING)
  totalKes  Int                      
  expiresAt DateTime    @db.Timestamptz   
  paidAt    DateTime?   @db.Timestamptz   
  createdAt DateTime    @default(now()) @db.Timestamptz
  updatedAt DateTime    @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])     
  @@index([eventId, status])       
  @@index([status, expiresAt])     
  @@map("orders")
}