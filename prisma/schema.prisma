// =============================================
// Prisma Schema — VIBE-CONNECT Database
// =============================================
// This schema defines the database structure.
// It will be populated with models in the next step.
//
// To apply changes:
//   npx prisma migrate dev --name <migration_name>
//
// To view data:
//   npx prisma studio
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Models will be added here in the next step.
// Each developer's module maps to specific models:
//
// Carlos (auth):
//   - User
//
// Phillip (events):
//   - Event
//   - TicketType
//
// Freddy (orders):
//   - Order
//   - OrderItem
//   - Ticket (digital ticket with QR)
