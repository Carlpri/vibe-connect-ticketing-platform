// =============================================
// Prisma Schema — VIBE-CONNECT Database
// =============================================
// Carlos's Domain:
// - Backend Foundation, Users, Authentication & Security
//
// Database Configuration:
// - Direct URL: Supabase Session pooler (port 5432) for migrations
// - Transaction URL: Supabase Transaction pooler (port 6543) for pooled queries
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// Carlos's Domain: User Roles & Authentication
// -------------------------------------------------------------

enum UserRole {
  ATTENDEE
  ORGANIZER
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole  @default(ATTENDEE)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  @@map("users")
}

