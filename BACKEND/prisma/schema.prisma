// =============================================
// Prisma Schema — VIBE-CONNECT Database
// =============================================
// Carlos's Domain:
// - Backend Foundation, Users, Authentication & Security
// - Email & Phone Contact Verification Lifecycle
//
// Events Domain:
// - Event
// - TicketType
//
// Freddy's Domain:
// - Order
// - OrderItem
// - Payment
// - Ticket (Digital QR ticket & check-in)
//
// Database Configuration:
// - Direct URL: Supabase Session pooler (port 5432) for migrations
// - Transaction URL: Supabase Transaction pooler (port 6543) for pooled queries
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// Carlos's Domain: User Roles & Authentication
// -------------------------------------------------------------

enum UserRole {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum OrganizerApplicationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  phone        String?  @unique
  role         UserRole @default(ATTENDEE)
  organizerApplicationStatus OrganizerApplicationStatus @default(NONE)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  // Verification Status Flags
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  // Email Verification Fields (tokens stored as SHA-256 hashes only)
  emailVerificationTokenHash     String?
  emailVerificationExpiresAt     DateTime? @db.Timestamptz
  emailVerificationCooldownUntil DateTime? @db.Timestamptz

  // Phone OTP Verification Fields (OTPs stored as SHA-256 hashes only)
  phoneVerificationOtpHash       String?
  phoneVerificationExpiresAt     DateTime? @db.Timestamptz
  phoneVerificationAttempts      Int       @default(0)
  phoneVerificationCooldownUntil DateTime? @db.Timestamptz

  // Password Reset Fields (tokens stored as SHA-256 hashes only)
  passwordResetTokenHash         String?
  passwordResetExpiresAt         DateTime? @db.Timestamptz
  passwordResetCooldownUntil     DateTime? @db.Timestamptz

  orders  Order[]
  events  Event[]
  tickets Ticket[]

  @@index([emailVerificationTokenHash])
  @@index([passwordResetTokenHash])
  @@map("users")
}

// -------------------------------------------------------------
// Events Domain:
// - Event
// - TicketType
// -------------------------------------------------------------

enum EventFormat {
  PHYSICAL
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  organizerId String      @db.Uuid
  title       String
  slug        String      @unique
  description String
  category    String
  coverImage  String?
  format      EventFormat @default(PHYSICAL)
  status      EventStatus @default(DRAFT)
  startsAt    DateTime    @db.Timestamptz
  endsAt      DateTime    @db.Timestamptz

  // Physical Location Details (for PHYSICAL or HYBRID events)
  venue       String?
  city        String?
  county      String?
  address     String?
  latitude    Float?
  longitude   Float?

  // Online Details (for ONLINE or HYBRID events)
  onlineUrl   String?

  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  organizer   User        @relation(fields: [organizerId], references: [id])
  ticketTypes TicketType[]
  tickets     Ticket[]

  @@index([status, startsAt])
  @@index([category, status])
  @@index([organizerId])
  @@map("events")
}

model TicketType {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  name        String
  description String?
  priceKes    Int
  capacity    Int
  sold        Int       @default(0)
  salesStart  DateTime? @db.Timestamptz
  salesEnd    DateTime? @db.Timestamptz
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@index([eventId, isActive])
  @@map("ticket_types")
}

// -------------------------------------------------------------
// Freddy's Domain:
// - Order
// - OrderItem
// - Payment
// -------------------------------------------------------------
enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  eventId   String      @db.Uuid
  status    OrderStatus @default(PENDING)
  totalKes  Int
  expiresAt DateTime    @db.Timestamptz
  paidAt    DateTime?   @db.Timestamptz
  createdAt DateTime    @default(now()) @db.Timestamptz
  updatedAt DateTime    @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  items    OrderItem[]
  payments Payment[]
  tickets  Ticket[]

  @@index([userId, createdAt])
  @@index([eventId, status])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  ticketTypeId String   @db.Uuid
  quantity     Int
  unitPriceKes Int
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([orderId, ticketTypeId])
  @@index([ticketTypeId])
  @@map("order_items")
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  VOID
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @db.Uuid
  orderItemId   String       @db.Uuid
  ticketTypeId  String       @db.Uuid
  eventId       String       @db.Uuid
  userId        String       @db.Uuid
  serialNumber  Int
  status        TicketStatus @default(ISSUED)
  checkedInAt   DateTime?    @db.Timestamptz
  checkedInById String?      @db.Uuid
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([orderItemId, serialNumber])
  @@index([userId, createdAt])
  @@index([eventId, status])
  @@index([orderId])
  @@map("tickets")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  orderId            String        @db.Uuid
  status             PaymentStatus @default(PENDING)
  amountKes          Int
  provider           String        @default("PAYSTACK")
  reference          String?       @unique
  currency           String        @default("KES")
  channel            String?
  customerEmail      String?
  phoneNumber        String?

  // Historical Daraja fields preserved for auditability
  merchantRequestId  String?
  checkoutRequestId  String?       @unique
  mpesaReceiptNumber String?       @unique
  resultCode         Int?
  resultDesc         String?
  rawCallback        Json?
  paidAt             DateTime?     @db.Timestamptz
  createdAt          DateTime      @default(now()) @db.Timestamptz
  updatedAt          DateTime      @updatedAt @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([reference])
  @@map("payments")
}

