# ============================================
# VIBE-CONNECT Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to Git!
# ============================================

# Server
NODE_ENV=development
PORT=3000

# Database (Supabase PostgreSQL)
# -----------------------------------------------
# Find these in your Supabase Dashboard:
#   Project Settings > Database > Connection string
#
# DATABASE_URL        → Used by Prisma for queries (Transaction Pooler, port 6543)
# DIRECT_URL          → Used by Prisma for migrations (Direct Connection, port 5432)
# -----------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# JWT Authentication
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d
# HMAC secret for signed ticket QR payloads (defaults to JWT_SECRET if unset)
TICKET_QR_SECRET=your-ticket-qr-secret-change-this

# Application & Frontend URLs
FRONTEND_URL=http://localhost:5173

# Email Provider Configuration (Resend)
# -----------------------------------------------
# Sign up at https://resend.com to obtain an API key.
# Leave blank during local testing to use the safe mock/preview adapter.
# -----------------------------------------------
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=VIBE-CONNECT <onboarding@resend.dev>
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
EMAIL_RESEND_COOLDOWN_SECONDS=60

# SMS Provider Configuration (Africa's Talking)
# -----------------------------------------------
# Sign up at https://africastalking.com to obtain credentials.
# Leave blank during local testing to use the safe mock/preview adapter.
# Supports either AT_* or AFRICASTALKING_* environment variable names.
# For Sandbox testing:
#   AT_USERNAME=sandbox
#   AT_SENDER_ID= (leave blank in sandbox mode)
# -----------------------------------------------
AT_API_KEY=atsk_your_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=
# Aliases:
# AFRICASTALKING_API_KEY=atsk_your_api_key_here
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_SENDER_ID=
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
