# ============================================
# VIBE-CONNECT Frontend Environment Variables
# ============================================
# Copy this file to .env and set your values:
#   cp .env.example .env
#
# NEVER commit your .env file to Git!
# ============================================

# Backend API base URL (no trailing slash)
# The backend exposes all endpoints under /api
# Example: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Enable development mock data (true | false)
# When true, event listings show static sample data
# when the real API is unavailable or returns no events.
# MUST be false in production.
VITE_MOCK_DATA=false
