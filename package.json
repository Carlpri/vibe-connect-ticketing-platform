{
  "name": "vibe-connect",
  "version": "1.0.0",
  "private": true,
  "description": "VIBE-CONNECT — Kenyan Event Discovery & Digital Ticketing Platform",
  "scripts": {
    "dev:backend": "npm --prefix BACKEND run dev",
    "dev:frontend": "npm --prefix FRONTEND run dev",
    "build:backend": "npm --prefix BACKEND run build",
    "build:frontend": "npm --prefix FRONTEND run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm --prefix BACKEND start",
    "test:backend": "npm --prefix BACKEND test",
    "install:backend": "npm --prefix BACKEND install",
    "install:frontend": "npm --prefix FRONTEND install",
    "install:all": "npm --prefix BACKEND install && npm --prefix FRONTEND install",
    "prisma:generate": "npm --prefix BACKEND run prisma:generate",
    "prisma:migrate": "npm --prefix BACKEND run prisma:migrate",
    "prisma:studio": "npm --prefix BACKEND run prisma:studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlpri/vibe-connect-ticketing-platform.git"
  },
  "keywords": [
    "events",
    "ticketing",
    "kenya",
    "monorepo",
    "react",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "Vibe-Connect Team",
  "license": "UNLICENSED"
}
