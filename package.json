  "description": "Kenyan Event Discovery & Digital Ticketing Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "test": "tsc && node --test dist/__tests__/**/*.test.js",
    "lint": "eslint src/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlpri/vibe-connect-ticketing-platform.git"
  },
  "keywords": [
    "events",
    "ticketing",
    "kenya",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "Vibe-Connect Team",
  "license": "UNLICENSED",
  "private": true,
  "bugs": {
    "url": "https://github.com/Carlpri/vibe-connect-ticketing-platform/issues"
  },
  "homepage": "https://github.com/Carlpri/vibe-connect-ticketing-platform#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.32.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
